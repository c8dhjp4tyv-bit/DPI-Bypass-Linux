#!/usr/bin/env python3
"""DPI Bypass GNOME arayüzü başlatıcısı."""

import os
import sys


def _add_package_path() -> None:
    here = os.path.dirname(os.path.realpath(__file__))
    candidates = (
        os.path.join(os.path.dirname(here), "src"),
        "/usr/lib/dpi-bypass",
        "/usr/local/lib/dpi-bypass",
    )
    for path in candidates:
        if os.path.isdir(os.path.join(path, "dpibypass")):
            sys.path.insert(0, path)
            return


_add_package_path()


def _ensure_socket_group() -> None:
    """Kullanıcı 'dpi-bypass' grubuna yeni eklendiyse oturumu kapatmadan uygula.

    usermod ile eklenen grup açık oturumdaki süreçlere yansımaz. Tanıyı
    dpibypass.session_access yapar; yalnızca "kullanıcı grup veritabanında
    üye ama bu süreç grubu almamış" durumunda uygulama bir kez 'sg' ile
    yeniden başlatılır. Diğer durumlarda (grup yok, üye değil, servis yok,
    soket izni bozuk) pencere açılır ve doğru tanı orada gösterilir.
    """
    try:
        from dpibypass import session_access
    except ImportError:
        return
    try:
        session_access.maybe_reexec_with_group(argv=sys.argv)
    except Exception:      # tanı hiçbir koşulda uygulamayı engellememeli
        pass


_ensure_socket_group()

try:
    import gi  # noqa: F401
except ImportError:
    sys.stderr.write(
        "PyGObject (python3-gi) bulunamadı.\n"
        "Kurulum: sudo dnf install python3-gobject gtk4 libadwaita\n"
        "         sudo apt install python3-gi gir1.2-gtk-4.0 gir1.2-adw-1\n"
        "         sudo pacman -S python-gobject gtk4 libadwaita\n"
    )
    raise SystemExit(1)

from dpibypass.gui.app import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
