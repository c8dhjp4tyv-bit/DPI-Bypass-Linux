#!/usr/bin/env python3
"""DPI Bypass komut satırı aracı."""

import os
import sys


def _add_package_path() -> None:
    here = os.path.dirname(os.path.realpath(__file__))
    candidates = (
        os.path.join(os.path.dirname(here), "src"),
        "/usr/lib/dpi-bypass",
        "/usr/local/lib/dpi-bypass",
    )
    for path in candidates:
        if os.path.isdir(os.path.join(path, "dpibypass")):
            sys.path.insert(0, path)
            return


_add_package_path()


def _ensure_socket_group() -> None:
    """Terminal oturumu da eski grup listesiyle çalışıyor olabilir.

    Arayüzle aynı mantık: kullanıcı grup veritabanında üyeyse ama bu süreç
    grubu almamışsa komut bir kez 'sg' ile yeniden çalıştırılır. 'doctor'
    komutu tanı içindir; onu asla yeniden başlatma, aksi halde kullanıcı
    sorunun kendisini göremez.
    """
    if len(sys.argv) > 1 and sys.argv[1] == "doctor":
        return
    try:
        from dpibypass import session_access
    except ImportError:
        return
    try:
        session_access.maybe_reexec_with_group(argv=sys.argv)
    except Exception:
        pass


_ensure_socket_group()

from dpibypass.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
